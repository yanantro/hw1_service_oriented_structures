@startuml C4_Container_Marketplace
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()
title Маркетплейс — C4 Container diagram

Person(buyer, "Покупатель", "Смотрит ленту, оформляет и оплачивает заказы")
Person(seller, "Продавец", "Управляет карточками товаров и остатками")

System_Ext(psp, "Платёжный провайдер", "Эквайринг: приём оплат, возвраты, webhooks")
System_Ext(msg, "Провайдеры доставки сообщений", "Email / SMS / Push")

System_Boundary(mp, "Маркетплейс") {
  Container(web, "Web / Mobile клиент", "SPA / iOS / Android", "UI для покупателей и кабинет продавца")
  Container(gw, "API Gateway", "Nginx / Envoy", "Единая точка входа, проверка JWT, роутинг, rate limit")

  Container(users, "User Service", "Python, FastAPI", "Регистрация, аутентификация, профили покупателей и продавцов, роли")
  ContainerDb(users_db, "Users DB", "PostgreSQL", "Аккаунты, профили, роли, адреса")

  Container(catalog, "Catalog Service", "Python, FastAPI", "Карточки товаров, категории, цены, остатки, резервы")
  ContainerDb(catalog_db, "Catalog DB", "PostgreSQL", "Товары, категории, цены, остатки, резервы")

  Container(feed, "Feed Service", "Python, FastAPI", "Персонализированная лента: кандидаты + ранжирование")
  ContainerDb(feed_store, "Feed DB", "PostgreSQL + Redis", "События поведения, копия каталога; готовые ленты в Redis")

  Container(orders, "Order Service", "Python, FastAPI", "Корзина, оформление заказа, статусная модель заказа")
  ContainerDb(orders_db, "Orders DB", "PostgreSQL", "Корзины, заказы, позиции, история статусов")

  Container(payments, "Payment Service", "Python, FastAPI", "Платежи, возвраты, учёт (ledger), расчёт с продавцами")
  ContainerDb(payments_db, "Payments DB", "PostgreSQL", "Платежи, проводки, комиссии, выплаты")

  Container(notif, "Notification Service", "Python, FastAPI", "Шаблоны, рассылка уведомлений о статусах")
  ContainerDb(notif_db, "Notifications DB", "PostgreSQL", "Контакты, подписки, шаблоны, журнал отправок")

  ContainerQueue(bus, "Event Bus", "Apache Kafka", "Доменные события между сервисами")
}

Rel(buyer, web, "Использует", "HTTPS")
Rel(seller, web, "Использует", "HTTPS")
Rel(web, gw, "API-запросы", "HTTPS/JSON")

Rel(gw, users, "Логин, профиль", "REST, sync")
Rel(gw, catalog, "Карточки, управление товарами", "REST, sync")
Rel(gw, feed, "Лента", "REST, sync")
Rel(gw, orders, "Корзина, заказы", "REST, sync")
Rel(gw, payments, "Статус оплаты", "REST, sync")

Rel(orders, catalog, "Цена/наличие, резерв остатков", "REST, sync")
Rel(orders, payments, "Создать платёж", "REST, sync")
Rel(payments, psp, "Платёж / возврат", "HTTPS, sync")
Rel(psp, payments, "Результат оплаты", "Webhook")
Rel(notif, msg, "Отправка сообщений", "HTTPS/SMTP")

Rel(users, bus, "UserRegistered, ContactsUpdated", "async")
Rel(catalog, bus, "ProductPublished/Updated/Removed", "async")
Rel(orders, bus, "OrderCreated, OrderStatusChanged", "async")
Rel(payments, bus, "PaymentSucceeded/Failed, Refunded", "async")
Rel(gw, bus, "UserBehaviorEvent (просмотры, клики)", "async")

Rel(bus, feed, "Товары, заказы, поведение", "async")
Rel(bus, orders, "Результаты оплат", "async")
Rel(bus, catalog, "OrderCancelled → снять резерв", "async")
Rel(bus, notif, "Статусы заказов и оплат, контакты", "async")

Rel(users, users_db, "R/W", "SQL")
Rel(catalog, catalog_db, "R/W", "SQL")
Rel(feed, feed_store, "R/W")
Rel(orders, orders_db, "R/W", "SQL")
Rel(payments, payments_db, "R/W", "SQL")
Rel(notif, notif_db, "R/W", "SQL")

SHOW_LEGEND()
@enduml
